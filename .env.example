# Database — SQLite for local dev. For Postgres: postgresql://user:pass@localhost:5432/adaig (and change provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Auth.js — generate with: npx auth secret   (or openssl rand -base64 32)
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true
# Stripe — TEST MODE ONLY (sk_test_...). Leave blank to use the built-in mock checkout.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
APP_URL="http://localhost:3000"
# Payments fail closed in production (QA BUG-024): with no Stripe test key and NODE_ENV=production, checkout shows an error.
# Set to "true" ONLY for a private demo to enable the mock checkout. Live keys (sk_live_) are always refused.
ALLOW_MOCK_PAYMENTS=""
# Login throttling (QA BUG-021/022): set "true" only when the app runs behind your own reverse proxy that appends X-Forwarded-For.
# TRUSTED_PROXY_HOPS = number of your proxies (the client IP is read that many entries from the right). Without it, no per-IP bucket is used.
TRUSTED_PROXY="false"
TRUSTED_PROXY_HOPS="1"
# What happens when staff reject a student (QA BUG-023): notice_manual_refund (default) | notice_only
REJECTED_STUDENT_POLICY="notice_manual_refund"

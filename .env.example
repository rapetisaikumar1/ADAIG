# ── Database: online Supabase Postgres (Supabase → your project → Connect → ORMs → Prisma) ─────────────────
# Runtime uses DATABASE_URL (transaction pooler, port 6543); migrations and seed use DIRECT_URL (session pooler, port 5432).
# Replace <ref>, <password> and <region>; URL-encode special characters in the password (@ → %40, # → %23, / → %2F, ? → %3F).
# Use a separate Supabase project for development/preview than for production, and keep PRODUCTION URLs out of this file
# (put them only in Vercel). db:reset, db:migrate, the seed and the e2e suite refuse any non-local database host anyway
# (anything but localhost / 127.0.0.1 / ::1) unless ALLOW_REMOTE_DB=1 is set for that one command.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# (Offline alternative: the Supabase CLI — `npx supabase start` — gives postgresql://postgres:postgres@127.0.0.1:54322/postgres for both.)
#
# On Vercel, either set DATABASE_URL / DIRECT_URL as above, or let the Supabase–Vercel integration add its variables:
#   POSTGRES_PRISMA_URL       pooled  (Supavisor transaction mode, port 6543, ?pgbouncer=true) → used by the app at runtime
#   POSTGRES_URL_NON_POOLING  direct / session (port 5432)                                    → used by migrations (vercel-build)
# or set them yourself (Supabase → Connect):
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# DATABASE_URL / DIRECT_URL win over the integration names. sslmode follows libpq: require = encrypted (no CA check),
# verify-full = verified. Optional: DB_POOL_MAX (connections per server instance, default 5; or connection_limit in the URL).
DB_POOL_MAX=""

# ── Auth.js ─────────────────────────────────────────────────────────────────────────────────────────────────
# Required in production. Generate with: npx auth secret   (or openssl rand -base64 32)
# The placeholder below only works locally: in production (NODE_ENV=production or on Vercel) a secret shorter than 32 characters
# or a placeholder like "change-me" is rejected at startup and by the build check (scripts/check-env.mjs).
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# ── Payments (Stripe TEST MODE ONLY, sk_test_...). Leave blank to use the built-in mock checkout. ───────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
APP_URL="http://localhost:3000"
# Payments fail closed in production (QA BUG-024): with no Stripe test key and NODE_ENV=production, checkout shows an error.
# Set to "true" ONLY for a private demo to enable the mock checkout. Live keys (sk_live_) are always refused.
ALLOW_MOCK_PAYMENTS=""
# "development" or "local" also allows the mock checkout (NODE_ENV=development does the same). Leave empty in production.
APP_ENV=""

# ── Client IP for throttling (login, contact form, sign-up/join) ───────────────────────────────────────────
# Set "true" only when the app runs behind a proxy that appends X-Forwarded-For — on Vercel: TRUSTED_PROXY=true, TRUSTED_PROXY_HOPS=1.
# TRUSTED_PROXY_HOPS = number of your proxies (the client IP is read that many entries from the right). Without it no per-IP
# limits are used (account lockout and the global hourly caps on contact messages and new accounts still apply).
TRUSTED_PROXY="false"
TRUSTED_PROXY_HOPS="1"

# ── Scheduled jobs (Vercel Cron, see vercel.json) ──────────────────────────────────────────────────────────────
# Daily job: expires stale unpaid orders, lapses memberships 30+ days past their renewal date, prunes throttle rows.
# Bearer token for /api/cron/* (Vercel sends "Authorization: Bearer $CRON_SECRET"). Unset = the cron routes answer 503.
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ── Policies (defaults; Admin → Settings → Operational policies overrides each of them) ─────────────────────────
# What happens when staff reject a student (QA BUG-023): notice_manual_refund (default) | notice_only
REJECTED_STUDENT_POLICY="notice_manual_refund"
# Hours before a legacy unpaid membership order expires (default 24).
# UNPAID_ORDER_TTL_HOURS="24"
# Account deletion: a paid event ticket is kept (default) or cancelled; a paid membership is cancelled without refund (default)
# or flagged "refund due" for staff.
# DELETED_USER_PAID_TICKETS="keep"            # keep | cancel
# DELETED_MEMBERSHIP_REFUND="none"            # none | flag_manual_refund

# ── Seeding a hosted database only (never needed locally) ──────────────────────────────────────────────────
# ALLOW_REMOTE_DB=1                  required (per command) for the seed / db:reset / db:migrate / e2e on a non-local host
# SEED_PASSWORD="<12+ characters>"   required for any non-localhost database
# SEED_FORCE=1                       allow the seed to wipe a database that already has users

# ── End-to-end tests (Playwright; see README → Testing) ──────────────────────────────────────────────────────
# The suite writes and deletes rows: it uses ONLY E2E_DATABASE_URL (never DATABASE_URL/DIRECT_URL) and refuses non-local hosts.
# E2E_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"   # the database of the app under test
# E2E_BASE_URL="http://localhost:3000"                                          # non-local needs E2E_ALLOW_REMOTE=1
# E2E_SEED_PASSWORD=""                                                          # if the database was seeded with SEED_PASSWORD

{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.12 || >=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && node scripts/check-rls.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:check-rls": "node scripts/check-rls.mjs",
    "vercel-build": "node scripts/check-env.mjs && prisma generate && prisma migrate deploy && node scripts/check-rls.mjs && next build",
    "unlock": "tsx scripts/unlock.ts",
    "expire-unpaid-orders": "tsx scripts/expire-unpaid-orders.mts",
    "extract-design": "python3 scripts/extract-design.py",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:cleanup": "tsx tests/e2e/support/cleanup-cli.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "bcryptjs": "^3.0.3",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.10",
    "pg": "^8.23.1",
    "prisma": "~7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
